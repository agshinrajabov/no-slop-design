{
  "$description": "Component tokens. Only when a semantic token cannot express the need. Alias semantics, not primitives.",
  "button": {
    "$type": "color",
    "primary": {
      "bg":         { "$value": "{color.action.primary}" },
      "bg-hover":   { "$value": "{color.action.primary-hover}" },
      "bg-pressed": { "$value": "{color.action.primary-pressed}" },
      "fg":         { "$value": "{color.text.on-action}" }
    },
    "secondary": {
      "bg":         { "$value": "{color.action.secondary}" },
      "bg-hover":   { "$value": "{color.action.secondary-hover}" },
      "fg":         { "$value": "{color.text.primary}" },
      "border":     { "$value": "{color.border.strong}" }
    }
  },
  "input": {
    "$type": "color",
    "bg":           { "$value": "{color.surface.raised}" },
    "border":       { "$value": "{color.border.strong}" },
    "border-focus": { "$value": "{color.border.focus}" },
    "border-error": { "$value": "{color.status.danger.fill}" },
    "placeholder":  { "$value": "{color.text.tertiary}" }
  }
}
