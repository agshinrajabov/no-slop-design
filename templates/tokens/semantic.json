{
  "$description": "Semantic (decision) tokens, light mode. UI code references ONLY these (and component tokens). Each aliases a primitive.",
  "color": {
    "$type": "color",
    "surface": {
      "base": {
        "$value": "{color.neutral.1}",
        "$description": "page background"
      },
      "raised": {
        "$value": "{color.white}",
        "$description": "panels, interactive cards, sheets"
      },
      "sunken": {
        "$value": "{color.neutral.2}",
        "$description": "wells, inputs on raised"
      },
      "overlay": {
        "$value": "{color.white}",
        "$description": "menus, popovers, dialogs"
      },
      "inverse": {
        "$value": "{color.neutral.12}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.neutral.12}"
      },
      "secondary": {
        "$value": "{color.neutral.11}"
      },
      "tertiary": {
        "$value": "{color.neutral.10}",
        "$description": "metadata; verify ≥ 4.5:1 on surface.base"
      },
      "disabled": {
        "$value": "{color.neutral.8}"
      },
      "on-action": {
        "$value": "{color.white}"
      },
      "on-inverse": {
        "$value": "{color.neutral.1}"
      },
      "link": {
        "$value": "{color.brand.11}"
      },
      "link-visited": {
        "$value": "{color.brand.12}"
      },
      "on-destructive": {
        "$value": "{color.white}",
        "$description": "Text on destructive fills; kept separate from on-action so dark mode can invert one without the other."
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.neutral.6}"
      },
      "strong": {
        "$value": "{color.neutral.8}"
      },
      "focus": {
        "$value": "{color.brand.9}"
      }
    },
    "action": {
      "primary": {
        "$value": "{color.brand.9}"
      },
      "primary-hover": {
        "$value": "{color.brand.10}"
      },
      "primary-pressed": {
        "$value": "{color.brand.11}"
      },
      "secondary": {
        "$value": "{color.neutral.3}"
      },
      "secondary-hover": {
        "$value": "{color.neutral.4}"
      },
      "secondary-pressed": {
        "$value": "{color.neutral.5}"
      },
      "destructive": {
        "$value": "{color.danger.9}"
      },
      "destructive-hover": {
        "$value": "{color.danger.11}"
      }
    },
    "status": {
      "success": {
        "fill": {
          "$value": "{color.success.9}"
        },
        "surface": {
          "$value": "{color.success.3}"
        },
        "text": {
          "$value": "{color.success.11}"
        }
      },
      "warning": {
        "fill": {
          "$value": "{color.warning.9}"
        },
        "surface": {
          "$value": "{color.warning.3}"
        },
        "text": {
          "$value": "{color.warning.11}"
        }
      },
      "danger": {
        "fill": {
          "$value": "{color.danger.9}"
        },
        "surface": {
          "$value": "{color.danger.3}"
        },
        "text": {
          "$value": "{color.danger.11}"
        }
      },
      "info": {
        "fill": {
          "$value": "{color.info.9}"
        },
        "surface": {
          "$value": "{color.info.3}"
        },
        "text": {
          "$value": "{color.info.11}"
        }
      }
    },
    "focus": {
      "$value": "{color.brand.9}"
    },
    "selection": {
      "$value": "{color.brand.4}"
    },
    "scrim": {
      "$value": "oklch(0.2 0.01 60 / 0.5)"
    },
    "skeleton": {
      "$value": "{color.neutral.4}"
    }
  },
  "space": {
    "$type": "dimension",
    "inset": {
      "xs": {
        "$value": "{space.2}"
      },
      "sm": {
        "$value": "{space.4}"
      },
      "md": {
        "$value": "{space.6}"
      },
      "lg": {
        "$value": "{space.8}"
      },
      "xl": {
        "$value": "{space.9}"
      }
    },
    "stack": {
      "xs": {
        "$value": "{space.2}"
      },
      "sm": {
        "$value": "{space.4}"
      },
      "md": {
        "$value": "{space.6}"
      },
      "lg": {
        "$value": "{space.8}"
      },
      "xl": {
        "$value": "{space.10}"
      },
      "section": {
        "$value": "clamp(3rem, 2rem + 4vw, 6rem)"
      }
    },
    "inline": {
      "xs": {
        "$value": "{space.2}"
      },
      "sm": {
        "$value": "{space.4}"
      },
      "md": {
        "$value": "{space.5}"
      },
      "lg": {
        "$value": "{space.6}"
      }
    },
    "gutter": {
      "$value": "{space.8}"
    },
    "margin": {
      "page": {
        "$value": "clamp(1rem, 0.5rem + 2.5vw, 3rem)"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": {
      "$value": "{radius.2}"
    },
    "card": {
      "$value": "{radius.4}"
    },
    "sheet": {
      "$value": "{radius.6}"
    },
    "pill": {
      "$value": "{radius.full}"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Two-layer, hue-tinted, low opacity. Dark mode uses surface steps instead (see semantic.dark.json).",
    "raised": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "oklch(0.3 0.02 60 / 0.06)"
        },
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "-2px",
          "color": "oklch(0.3 0.02 60 / 0.08)"
        }
      ]
    },
    "overlay": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "-2px",
          "color": "oklch(0.3 0.02 60 / 0.08)"
        },
        {
          "offsetX": "0px",
          "offsetY": "16px",
          "blur": "32px",
          "spread": "-4px",
          "color": "oklch(0.3 0.02 60 / 0.14)"
        }
      ]
    },
    "modal": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "24px",
          "blur": "64px",
          "spread": "-8px",
          "color": "oklch(0.3 0.02 60 / 0.24)"
        }
      ]
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "Sizes are fluid clamp() from scripts/type_scale.py (16→18 base, 1.2→1.25).",
    "display": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "clamp(2.986rem, 2.532rem + 2.271vw, 4.292rem)",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": 1.02,
        "letterSpacing": "-0.03em"
      }
    },
    "h1": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "clamp(2.074rem, 1.84rem + 1.17vw, 2.747rem)",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": 1.1,
        "letterSpacing": "-0.02em"
      }
    },
    "h2": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "clamp(1.728rem, 1.565rem + 0.8161vw, 2.197rem)",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": 1.2,
        "letterSpacing": "-0.01em"
      }
    },
    "h3": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "clamp(1.44rem, 1.329rem + 0.5527vw, 1.758rem)",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": 1.25,
        "letterSpacing": "-0.01em"
      }
    },
    "h4": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "clamp(1.2rem, 1.128rem + 0.3587vw, 1.406rem)",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": 1.4,
        "letterSpacing": "0"
      }
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "clamp(1.125rem, 1.08rem + 0.2vw, 1.25rem)",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.6,
        "letterSpacing": "0"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "clamp(1rem, 0.9565rem + 0.2174vw, 1.125rem)",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.55,
        "letterSpacing": "0"
      }
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "0.875rem",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.5,
        "letterSpacing": "0"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "0.875rem",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": 1.3,
        "letterSpacing": "0"
      }
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "0.75rem",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.35,
        "letterSpacing": "0.01em"
      }
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "0.875rem",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.55,
        "letterSpacing": "0"
      }
    }
  }
}