{
  "$description": "Dark mode overrides. Only tokens that differ from semantic.json. Separate palette, elevation by lightness, accents desaturated.",
  "color": {
    "$type": "color",
    "surface": {
      "base": {
        "$value": "{color.neutral-dark.1}"
      },
      "raised": {
        "$value": "{color.neutral-dark.2}"
      },
      "sunken": {
        "$value": "{color.neutral-dark.1}"
      },
      "overlay": {
        "$value": "{color.neutral-dark.3}"
      },
      "inverse": {
        "$value": "{color.neutral-dark.12}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.neutral-dark.12}"
      },
      "secondary": {
        "$value": "{color.neutral-dark.11}"
      },
      "tertiary": {
        "$value": "{color.neutral-dark.10}"
      },
      "disabled": {
        "$value": "{color.neutral-dark.8}"
      },
      "on-inverse": {
        "$value": "{color.neutral-dark.1}"
      },
      "link": {
        "$value": "{color.brand.6}"
      },
      "link-visited": {
        "$value": "{color.brand.7}"
      },
      "on-action": {
        "$value": "{color.neutral-dark.1}",
        "$description": "Dark text on the lighter dark-mode brand fill; white would fail 4.5:1 on brand.8."
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.neutral-dark.6}"
      },
      "strong": {
        "$value": "{color.neutral-dark.8}"
      },
      "focus": {
        "$value": "{color.brand.8}"
      }
    },
    "action": {
      "primary": {
        "$value": "{color.brand.8}"
      },
      "primary-hover": {
        "$value": "{color.brand.7}"
      },
      "primary-pressed": {
        "$value": "{color.brand.6}",
        "$description": "In dark mode pressed goes lighter, toward the light source."
      },
      "secondary": {
        "$value": "{color.neutral-dark.3}"
      },
      "secondary-hover": {
        "$value": "{color.neutral-dark.4}"
      },
      "secondary-pressed": {
        "$value": "{color.neutral-dark.5}"
      },
      "destructive": {
        "$value": "{color.danger.9}"
      }
    },
    "focus": {
      "$value": "{color.brand.8}"
    },
    "selection": {
      "$value": "{color.brand.12}"
    },
    "scrim": {
      "$value": "oklch(0.05 0.005 60 / 0.6)"
    },
    "skeleton": {
      "$value": "{color.neutral-dark.4}"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Shadows are nearly invisible on dark surfaces; elevation comes from surface.raised/overlay lightness steps.",
    "raised": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "oklch(0 0 0 / 0.4)"
        }
      ]
    },
    "overlay": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "24px",
          "spread": "-4px",
          "color": "oklch(0 0 0 / 0.5)"
        }
      ]
    },
    "modal": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "24px",
          "blur": "64px",
          "spread": "-8px",
          "color": "oklch(0 0 0 / 0.6)"
        }
      ]
    }
  }
}